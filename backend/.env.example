# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────
# When running with Docker Compose, use the service name "postgres"
DATABASE_URL=postgresql://nutriguide:nutriguide_password@postgres:5432/nutriguide

# When running locally (outside Docker), use localhost:
# DATABASE_URL=postgresql://nutriguide:nutriguide_password@localhost:5432/nutriguide

# ── AI / LLM Keys ─────────────────────────────────────────
GROQ_API_KEY=

# ── Vector DB ─────────────────────────────────────────────
PINECONE_API_KEY=

# ── HuggingFace (for model downloads) ────────────────────
HF_TOKEN=
